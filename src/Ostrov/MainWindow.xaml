<Window x:Class="Ostrov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bd="clr-namespace:Ostrov.Backdrop"
        xmlns:local="clr-namespace:Ostrov"
        Title="Остров"
        Width="600" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Top="0"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <!-- Вкладка шапки: значок серый, при наведении светлее, активная белая; у выбранной под значком пластина и рядом выезжает подпись (TabMarks.Select и TabMarks.LabelWidth анимируются из MainWindow.Tabs.cs). -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A9199" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Plate" CornerRadius="18" Background="#8C212529"
                                    IsHitTestVisible="False"
                                    Opacity="{Binding (local:TabMarks.Select), RelativeSource={RelativeSource TemplatedParent}}" />
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="32" Height="36">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Метка активности (таймер идёт, музыка играет): маленькая точка под значком. -->
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                             IsHitTestVisible="False"
                                             Fill="{Binding (local:TabMarks.Brush), RelativeSource={RelativeSource TemplatedParent}}"
                                             Opacity="{Binding (local:TabMarks.Amount), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                                <Border Width="{Binding (local:TabMarks.LabelWidth), RelativeSource={RelativeSource TemplatedParent}}" ClipToBounds="True">
                                    <TextBlock Text="{Binding (local:TabMarks.Label), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Medium"
                                               Opacity="{Binding (local:TabMarks.Select), RelativeSource={RelativeSource TemplatedParent}}"
                                               TextWrapping="NoWrap" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,1" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#C8C8C8" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#E9ECEF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Вкладка «второго плана» (центр управления): у правого края, тусклее и мельче остальных, чтобы не маячила. -->
        <Style x:Key="SideTabButton" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="Foreground" Value="#8A9199" />
            <Setter Property="FontSize" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#B0B0B0" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#E9ECEF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Окно чуть больше раскрытого острова (запас под лёгкий «пружинный» перелёт анимации) и прозрачно.
         Прозрачные пиксели пропускают клики, поэтому мешать другим окнам оно не будет.
         Видимая плашка — Border ниже; её размер и скругление задаёт свойство Progress (0 = свёрнут, 1 = раскрыт). -->
    <Grid>
        <Border x:Name="Island"
                Width="200" Height="36"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#E0000000"
                CornerRadius="0,0,18,18"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                MouseRightButtonDown="Island_MouseRightButtonDown"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                RenderTransformOrigin="0.5,0">
            <!-- Баунс при наведении: масштаб от верхнего края по центру (верх острова вплотную к экрану). -->
            <Border.RenderTransform>
                <ScaleTransform x:Name="BounceScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid>
            <!-- Затемнение у нижнего края: прячет полосу без размытия под низом острова. Высоту, скругление и силу задаёт UpdateBlurBounds. -->
            <!-- Свёрнутый остров (решение пользователя 2026-11-20): ровный чёрный 88 % как раньше, без оттенка, кромки и блика; слой гаснет по мере раскрытия (ApplyGlassAmount). -->
            <Border x:Name="CollapsedFill" IsHitTestVisible="False" Background="Black" Opacity="1" />
            <!-- Оттенок заливки по вкладке (8 %, выбор пользователя): цвет вкладки чуть окрашивает остров; цвет плавно меняется при смене вкладки (ApplyTabTint). -->
            <Border x:Name="TintFill" IsHitTestVisible="False" Opacity="0"><Border.Background><SolidColorBrush Color="#12215E" /></Border.Background></Border>
            <Border x:Name="BottomFade" VerticalAlignment="Bottom" Height="0" IsHitTestVisible="False" Visibility="Collapsed" />
            <!-- Блик стекла: мягкий светлый свет сверху (вариант 1 по монотонности, решение пользователя 2026-11-20). Сила зависит от высоты острова (NoteIslandLayoutChanged). -->
            <Border x:Name="GlassSheen" VerticalAlignment="Top" Height="108" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0DFFFFFF" Offset="0" />
                        <GradientStop Color="#05FFFFFF" Offset="0.45" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Цветной фон по обложке (вкладка «Плеер»): под всем содержимым, размер раскрытого острова. Размер, прозрачность и видимость задаёт UpdateGlow. -->
            <bd:CoverGlow x:Name="Glow" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />
            <!-- Пассивный индикатор в свёрнутом состоянии (например, рендер After Effects): остров чуть расширяется и показывает его.
                 Размер хоста — размер индикатора; при раскрытии острова индикатор гаснет. Клики проходят сквозь него в Island. -->
            <ContentControl x:Name="ActivityHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" Foreground="#E9ECEF"
                            RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ActivityScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ActivityShift" X="0" />
                    </TransformGroup>
                </ContentControl.RenderTransform>
            </ContentControl>
            <!-- Содержимое всегда имеет размер раскрытого острова; при сворачивании его обрезает Island и оно гаснет. -->
            <Grid x:Name="ContentRoot" Width="520" Height="220"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.97" ScaleY="0.97" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="ModuleHost" Grid.Row="1" Margin="24,0,24,14"
                                Foreground="#E9ECEF" Focusable="False" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TransformGroup>
                            <SkewTransform x:Name="ModuleSkew" AngleX="0" />
                            <TranslateTransform x:Name="ModuleShift" X="0" />
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>
                <!-- Снимок уходящей вкладки при листании: уезжает и гаснет, пока новая приезжает (см. SwapModule). -->
                <Image x:Name="ModuleGhost" Grid.Row="1" Margin="24,0,24,14" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stretch="None" IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <SkewTransform x:Name="GhostSkew" AngleX="0" />
                            <TranslateTransform x:Name="GhostShift" X="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <!-- Шапка: слева вкладки (у выбранной подпись), справа часы и шестерёнка настроек. Боковые поля 21 + поле кнопки 1 + отступ значка 2 ≈ 24, как у содержимого. -->
                <Grid x:Name="TabStrip" Grid.Row="0" Margin="22,8,22,6" Height="36">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="HeaderClock" Foreground="#8A8A8A" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,1" Text="" IsHitTestVisible="False" />
                        <StackPanel x:Name="SideTabBar" Orientation="Horizontal" />
                    </StackPanel>
                </Grid>
                <!-- Карточка поверх вкладок (запрос Claude): пока она есть, вкладки и их панель скрыты. -->
                <ContentControl x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="2" Margin="24,0,24,0"
                                Foreground="#E9ECEF" Focusable="False" Visibility="Collapsed" />
            </Grid>
            <!-- Светлая тонкая обводка по краю острова (М-001). Сверху нет: там край экрана. Размеры и скругление задаёт ApplyProgress. -->
            <!-- Светлая кромка стекла: тонкая линия по бокам и снизу, ярче сверху и снизу (ловит свет), как у Liquid Glass. Скругление задаёт NoteIslandLayoutChanged. -->
            <Border x:Name="GlassRim" BorderThickness="1,0,1,1" CornerRadius="0,0,18,18" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1AFFFFFF" Offset="0" />
                        <GradientStop Color="#1AFFFFFF" Offset="0.55" />
                        <GradientStop Color="#1AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <Border x:Name="Outline" BorderBrush="#FFFFFF" BorderThickness="1,0,1,1" CornerRadius="0,0,18,18"
                    Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <!-- Перемычка между островом и кружком при обмене активностей: чёрная форма того же цвета, что остров, поэтому они выглядят одной каплей (см. UpdateDropNeck). Координаты окна. -->
        <Path x:Name="DropNeck" Fill="#E0000000" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />
        <!-- Вторая и третья пассивные активности: маленькие кружки по бокам острова (как у Apple): справа вторая, слева третья.
             Положение и появление задаёт UpdateBubble; клик по кружку делает его главным (ActivityCenter.Promote). -->
        <!-- Свободный круг 30 px: центр на линии значков плашки (1,5 px выше центра острова), к верху экрана не прилипает. -->
        <Border x:Name="Bubble"
                Width="30" Height="30" Margin="0,1.5,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#E0000000" CornerRadius="15" ClipToBounds="True"
                Opacity="0" Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BubbleShift" X="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <ContentControl x:Name="BubbleHost" Focusable="False" IsHitTestVisible="False" Foreground="#E9ECEF" />
                <Border BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="15" IsHitTestVisible="False"
                        Opacity="{Binding Opacity, ElementName=Outline}" />
            </Grid>
        </Border>
        <Border x:Name="BubbleLeft"
                Width="30" Height="30" Margin="0,1.5,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#E0000000" CornerRadius="15" ClipToBounds="True"
                Opacity="0" Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleLeftScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BubbleLeftShift" X="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <ContentControl x:Name="BubbleLeftHost" Focusable="False" IsHitTestVisible="False" Foreground="#E9ECEF" />
                <Border BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="15" IsHitTestVisible="False"
                        Opacity="{Binding Opacity, ElementName=Outline}" />
            </Grid>
        </Border>
    </Grid>
</Window>
